---
type Author = {
  name: string;
  url?: string;
  institution?: string;
  note?: string;
};
type Link = { name: string; url: string };
interface Props {
  title: string;
  titleLead: string;
  titleDetail: string;
  tagline: string;
  authors?: Author[];
  affiliation?: string;
  authorNotes?: string;
  links?: Link[];
}
const {
  title,
  titleLead,
  titleDetail,
  tagline,
  authors = [],
  affiliation,
  authorNotes,
  links = [],
} = Astro.props;
---

<header class="hero section-shell" id="top">
  <p class="eyebrow">
    <span class="status-dot" aria-hidden="true"></span> Proactive Human-in-the-Loop
  </p>
  <h1 aria-label={title}>
    {titleLead}<span class="title-detail">{titleDetail}</span>
  </h1>
  {
    authors.length > 0 && (
      <div class="authors">
        {authors.map((author) => (
          <div>
            {author.url ? (
              <a href={author.url}>{author.name}</a>
            ) : (
              <span>{author.name}</span>
            )}
            {author.note && <sup class="author-note">{author.note}</sup>}
            {author.institution && <small>{author.institution}</small>}
          </div>
        ))}
      </div>
    )
  }
  {
    authors.length > 0 && affiliation && (
      <p class="author-affiliation">{affiliation}</p>
    )
  }
  {
    authors.length > 0 && authorNotes && (
      <p class="author-explanation">{authorNotes}</p>
    )
  }
  <p class="hero-description">{tagline}</p>
  <div class="hero-actions">
    <a class="button button-primary" href="#video"
      ><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
        ><path d="m8 5 11 7-11 7Z" fill="currentColor"></path></svg
      >Watch the video</a
    >
    <a class="button button-secondary" href="#results"
      >Explore the results <span aria-hidden="true">↗</span></a
    >
    {
      links.map((link) => (
        <a class="button button-secondary" href={link.url}>
          {link.name}
        </a>
      ))
    }
  </div>
  <div class="hero-topics">
    <span>XR trajectory preview</span><span>Human correction</span><span
      >Preference learning</span
    >
  </div>
</header>
