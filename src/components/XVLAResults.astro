---
import { xvlaResults } from "../data/results";
---

<div class="xvla-results">
  {
    xvlaResults.map(({ task, rows }) => (
      <div class="task-results">
        <>
          <h4>{task}</h4>
          <div
            class="table-scroll"
            role="region"
            aria-label={`${task} X-VLA results`}
            tabindex="0"
          >
            <table>
              <>
                <caption class="sr-only">
                  X-VLA {task}: full-task success rate and normalized task
                  completion score (%) at three base-demonstration budgets.
                </caption>
                <thead>
                  <>
                    <tr>
                      <>
                        <th rowspan="2" scope="col">
                          Method
                        </th>
                        <th colspan="2" scope="colgroup">
                          10 demos
                        </th>
                        <th colspan="2" scope="colgroup">
                          20 demos
                        </th>
                        <th colspan="2" scope="colgroup">
                          30 demos
                        </th>
                      </>
                    </tr>
                    <tr>
                      {[10, 20, 30].map(() => (
                        <>
                          <th scope="col">
                            <abbr title="Full-task success rate">SR</abbr>
                          </th>
                          <th scope="col">
                            <abbr title="Normalized task completion score">
                              TCS
                            </abbr>
                          </th>
                        </>
                      ))}
                    </tr>
                  </>
                </thead>
                <tbody>
                  {rows.map(({ method, values }) => (
                    <tr class:list={{ "phil-row": method === "PHIL" }}>
                      <th scope="row">{method}</th>
                      {values.map((value, i) => (
                        <td>
                          {value === null
                            ? "—"
                            : i % 2 === 0
                              ? value.toFixed(0)
                              : value.toFixed(1)}
                        </td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </>
            </table>
          </div>
        </>
      </div>
    ))
  }
  <p class="results-note">
    All values are percentages over 25 evaluation rollouts per condition. SR:
    full-task success rate. TCS: normalized task completion score across three
    ordered stages. TCS is not reported for Towel Folding. Blue shading
    identifies PHIL.
  </p>
</div>
