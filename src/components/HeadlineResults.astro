---
import { headlineResults } from "../data/results";
---

<section class="highlights section-shell" aria-labelledby="highlights-title">
  <div class="highlights-intro">
    <p class="eyebrow">Five correction episodes</p><h2 id="highlights-title">
      Small correction budget.<br />{" "}Stronger policies.
    </h2><p>Mean task success after post-training.</p>
  </div>
  <div class="metrics-grid">
    {
      headlineResults.map((result) => (
        <article class="metric">
          <>
            <h3>{result.policy}</h3>
            <div class="metric-values">
              <>
                <span class="baseline-value">
                  {result.baseline}
                  <small>%</small>
                </span>
                <span class="metric-arrow" aria-hidden="true">
                  →
                </span>
                <strong>
                  {result.phil}
                  <small>%</small>
                </strong>
              </>
            </div>
            <div class="metric-labels">
              <>
                <span>HG-DAgger</span>
                <span>PHIL</span>
              </>
            </div>
            <p class="metric-scope">{result.scope}</p>
          </>
        </article>
      ))
    }
  </div>
  <p class="results-note">
    Unweighted means over each policy’s evaluated tasks and demonstration
    budgets. HG-DAgger uses reactive corrections; PHIL uses proactive
    corrections. Each condition uses five correction rollout episodes, with
    multiple interventions allowed.
  </p>
</section>
